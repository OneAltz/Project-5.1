{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "GCC: Build Project",
            "type": "process",
            "command": "/usr/bin/gcc",
            "args": [
                "-Wall",
                "-Wextra",
                "-std=c11",
                "-g",
                "${workspaceFolder}/main.c",
                "${workspaceFolder}/Solutions.c",
                "-o",
                "${workspaceFolder}/main"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}